<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <None Update="..\ReiStar.SampleGame\GoogleSans-Regular.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>GoogleSans-Regular.ttf</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ppy.SDL3-CS" Version="2026.722.0" />
    <PackageReference Include="ppy.SDL3_image-CS" Version="2026.722.0" />
    <PackageReference Include="ppy.SDL3_ttf-CS" Version="2026.722.0" />
    <PackageReference Include="Hexa.NET.ImGui" Version="2.2.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReiStar.Core\ReiStar.Core.csproj" />
    <ProjectReference Include="..\ReiStar.Graphics\ReiStar.Graphics.csproj" />
    <ProjectReference Include="..\ReiStar.Renderer.SDL3\ReiStar.Renderer.SDL3.csproj" />
    <ProjectReference Include="..\ReiStar.Shapes\ReiStar.Shapes.csproj" />
    <ProjectReference Include="..\ReiStar.Audios\ReiStar.Audios.csproj" />
    <ProjectReference Include="..\ReiStar.Input\ReiStar.Input.csproj" />
    <ProjectReference Include="..\ReiStar.Maths\ReiStar.Maths.csproj" />
    <ProjectReference Include="..\ReiStar.Points\ReiStar.Points.csproj" />
  </ItemGroup>

</Project>
