<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FFmpeg.AutoGen" Version="8.1.0" />
    <PackageReference Include="NLayer" Version="2.0.1" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <PackageReference Include="Silk.NET.OpenAL" Version="2.23.0" />
    <PackageReference Include="ppy.SDL3-CS" Version="2026.722.0" />
    <PackageReference Include="ppy.SDL3_ttf-CS" Version="2026.722.0" />
    <PackageReference Include="ppy.SDL3_image-CS" Version="2026.722.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="GoogleSans-Regular.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Native OpenAL Soft library (platform-conditional) -->
    <Content Include="ThirdParty\win-x64\soft_oal.dll" Condition="'$(RuntimeIdentifier)' == '' Or $(RuntimeIdentifier.StartsWith('win'))">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>soft_oal.dll</Link>
    </Content>
    <Content Include="ThirdParty\linux-x64\libopenal.so.1" Condition="$(RuntimeIdentifier.StartsWith('linux'))">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>libopenal.so.1</Link>
    </Content>
    <Content Include="ThirdParty\osx-arm64\libopenal.1.dylib" Condition="$(RuntimeIdentifier.StartsWith('osx'))">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>libopenal.1.dylib</Link>
    </Content>
    <Content Include="ThirdParty\android-arm64\libopenal.so" Condition="$(RuntimeIdentifier.StartsWith('android'))">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>libopenal.so</Link>
    </Content>
  </ItemGroup>

</Project>
