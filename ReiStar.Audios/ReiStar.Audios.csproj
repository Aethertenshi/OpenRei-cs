<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.OpenAL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenAL.Extensions.Soft" Version="2.23.0" />
    <PackageReference Include="NLayer" Version="2.0.1" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReiStar.Core\ReiStar.Core.csproj" />
    <ProjectReference Include="..\ReiStar.Maths\ReiStar.Maths.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="soft_oal.dll" Condition="Exists('soft_oal.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="soft_oal.dll" Condition="Exists('soft_oal.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>OpenAL32.dll</Link>
    </None>
  </ItemGroup>

</Project>
